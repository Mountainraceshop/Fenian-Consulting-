---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const focusAreas = [
  'cash-flow pressure',
  'customer pipeline',
  'sales and marketing',
  'pricing and margins',
  'workflow and operations',
  'staff issues',
  'owner overload',
  'supplier and customer communication',
  'systems and accountability',
];
---

<Layout
  title="Business Turnaround"
  description="Fenian Consulting provides practical turnaround support, business recovery planning and turnaround assessments for businesses under serious pressure."
>
  <PageHero
    eyebrow="Business Turnaround"
    title="Business Turnaround"
    intro="When a business is failing, the owner usually already knows something is wrong. The hard part is knowing what to fix first."
  />

  <section class="section">
    <div class="container narrow">
      <h2>Practical support when the pressure is serious</h2>
      <p>
        Fenian Consulting provides practical turnaround support for businesses
        under serious pressure. We assess the situation, identify the real
        problems, stabilise what can be stabilised and build a recovery plan
        that can be acted on.
      </p>
      <p>
        We use strong, direct advice without promising guaranteed survival,
        profit or financial results. The focus is clear thinking, practical
        systems and disciplined action.
      </p>
      <p>
        This service is priced according to the size, urgency, location, risk and
        level of involvement required.
      </p>
      <span class="price-tag">Price on application</span>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we focus on</span>
        <h2>The problems that usually decide what happens next</h2>
        <p class="lead">
          Turnaround work starts by finding the pressure points and setting the
          right order of action.
        </p>
      </div>
      <ul class="pressure-grid">
        {focusAreas.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">First step</span>
      <h2>Turnaround Assessment</h2>
      <p>
        Before any serious intervention, we complete an assessment of the
        business, the owner&rsquo;s goals, current risks, cash pressure, customer
        base, staff situation and available recovery options.
      </p>
      <p>
        The result is a clear recommendation: stabilise, restructure, rebuild,
        sell, pause or exit.
      </p>
      <div class="tier-note">
        <p>
          Fenian Consulting cannot guarantee that every business can be saved.
          What we can do is bring clear thinking, direct action, practical systems
          and disciplined recovery planning when the business needs it most.
        </p>
      </div>
      <a class="btn btn--primary" href="/contact/">Request a Turnaround Assessment</a>
    </div>
  </section>

  <CtaBand
    heading="Under serious pressure? Let's talk now."
    text="The sooner we look at the situation, the more options you have. Request a turnaround assessment and we will respond quickly."
  />
</Layout>

<style>
  .narrow {
    max-width: 760px;
  }
  .price-tag {
    display: inline-block;
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .pressure-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.6rem;
    margin: 1.25rem 0;
  }
  .pressure-grid li {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0.6rem 0.9rem;
    color: var(--color-navy);
    font-weight: 500;
  }
  .tier-note {
    border-left: 4px solid var(--color-accent);
    background: var(--color-bg-alt);
    padding: 0.5rem 1.25rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    margin-bottom: 1.75rem;
    font-style: italic;
  }
  .tier-note p {
    margin: 0.75rem 0;
  }
</style>
