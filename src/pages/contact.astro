---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<Layout
  title="Contact"
  description="Book a consultation with Fenian Consulting. Practical strategy, clear communication and real-world recovery for small business, regional business and community organisations."
>
  <PageHero
    eyebrow="Contact"
    title="Book a consultation"
    intro="Tell us a little about your business or organisation and what you are trying to sort out. We will get back to you with the most practical next step."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-form-wrap">
        <!--
          FORM SETUP
          ----------
          This form is ready to connect to any form handler (Formspree, Netlify
          Forms, Basin, your own endpoint, etc.). To go live:
          1. Set `data-endpoint` on the <form> to your handler URL, and
          2. change the method/action to match your provider.
          Until an endpoint is set, submitting shows an on-page confirmation so
          the form can be tested. No data is sent anywhere.
        -->
        <form id="contact-form" class="contact-form" method="post" data-endpoint="">
          <div class="field">
            <label for="name">Your name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <div class="field">
            <label for="organisation">Business or organisation</label>
            <input id="organisation" name="organisation" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="topic">What do you need help with?</label>
            <select id="topic" name="topic">
              <option value="Business Coaching">Business Coaching</option>
              <option value="Business Audit">Business Audit &amp; Action Plan</option>
              <option value="Business Turnaround">Business Turnaround</option>
              <option value="Marketing & Communications">Marketing &amp; Communications</option>
              <option value="Tender & Grant Support">Tender &amp; Grant Support</option>
              <option value="Event & Community Growth">Event &amp; Community Growth</option>
              <option value="Something else">Something else</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Your message <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn--primary">Send Message</button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact-aside">
        <h2>Talk to us directly</h2>
        <p>{site.bookingNote}</p>
        <ul class="contact-list">
          <li>
            <span class="contact-label">Contact</span>
            <span>{site.principal}</span>
            <span>{site.name}</span>
          </li>
          <li>
            <span class="contact-label">Email</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="contact-label">Phone</span>
            <span>{site.phone}</span>
          </li>
          <li>
            <span class="contact-label">Website</span>
            <a href={`https://${site.domain}`}>{site.domain}</a>
          </li>
          <li>
            <span class="contact-label">Area served</span>
            <span>{site.location}</span>
          </li>
        </ul>
        <div class="aside-note">
          <h3>Not sure where to start?</h3>
          <p>
            That is fine. Tell us what is going on and we will point you to the
            most practical option — whether that is mentoring, a business audit or
            a full turnaround.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  label {
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.95rem;
  }
  label span {
    color: var(--color-accent);
  }
  input,
  select,
  textarea {
    font: inherit;
    color: var(--color-text);
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    width: 100%;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(191, 98, 48, 0.15);
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #c0392b;
  }
  .contact-form .btn {
    justify-self: start;
  }
  .form-status {
    margin: 0;
    font-weight: 600;
    min-height: 1.4em;
  }
  .form-status.error {
    color: #c0392b;
  }
  .form-status.success {
    color: #1f7a44;
  }

  .contact-aside {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .contact-aside h2 {
    margin-top: 0;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
  }
  .contact-list li {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .contact-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    font-weight: 700;
  }
  .aside-note h3 {
    font-size: 1.1rem;
  }
  .aside-note p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');

  function setError(field: HTMLInputElement | HTMLTextAreaElement, on: boolean) {
    field.setAttribute('aria-invalid', String(on));
  }

  if (form && status) {
    form.noValidate = true;
    let isSubmitting = false;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isSubmitting) return;

      status.textContent = '';
      status.className = 'form-status';

      const required = ['name', 'email', 'message'] as const;
      let firstInvalid: HTMLElement | null = null;

      for (const id of required) {
        const field = form.elements.namedItem(id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | null;
        if (!field) continue;
        const empty = !field.value.trim();
        const badEmail =
          id === 'email' && !!field.value && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(field.value);
        const invalid = empty || badEmail;
        setError(field, invalid);
        if (invalid && !firstInvalid) firstInvalid = field;
      }

      if (firstInvalid) {
        status.textContent = 'Please complete the required fields with a valid email.';
        status.classList.add('error');
        firstInvalid.focus();
        return;
      }

      const endpoint = form.dataset.endpoint?.trim();
      const data = new FormData(form);

      if (endpoint) {
        isSubmitting = true;
        if (submitButton) submitButton.disabled = true;

        try {
          status.textContent = 'Sending…';
          const res = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = 'Thanks — your message has been sent. We will be in touch soon.';
          status.classList.add('success');
        } catch {
          status.textContent =
            'Sorry, something went wrong sending your message. Please email us directly.';
          status.classList.add('error');
        } finally {
          isSubmitting = false;
          if (submitButton) submitButton.disabled = false;
        }
      } else {
        // No endpoint configured yet — confirm on page so the form is testable.
        const name = String(data.get('name') ?? '').trim();
        form.reset();
        status.textContent = `Thanks ${name}! Your message is ready. Connect a form handler (see the code comment) to start receiving submissions, or email craig@fenian-consulting.com.au directly in the meantime.`;
        status.classList.add('success');
      }
    });
  }
</script>
