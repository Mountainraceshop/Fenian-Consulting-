---
interface Props {
  title: string;
  summary: string;
  href?: string;
}
const { title, summary, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="card" {...href ? { href } : {}}>
  <h3>{title}</h3>
  <p>{summary}</p>
  {href && <span class="card__more">Learn more &rarr;</span>}
</Tag>
